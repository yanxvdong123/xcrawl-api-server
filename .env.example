# Environment Variables
# Copy this to .env and fill in your values

# XCrawl API Key (required)
XCRAWL_API_KEY=your_xcrawl_api_key_here

# RapidAPI proxy secret (optional - for production RapidAPI deployment)
RAPIDAPI_SECRET=

# Fallback API token for direct non-RapidAPI use (optional)
API_TOKEN=

# Server port (default 3000)
PORT=3000
